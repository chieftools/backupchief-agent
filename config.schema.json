{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pkg.backup.chief.app/config.schema.json",
  "title": "Backup Chief agent configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "destinations", "jobs"],
  "properties": {
    "$schema": { "const": "https://pkg.backup.chief.app/config.schema.json" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "host": { "$ref": "#/$defs/host" },
    "realtime": { "$ref": "#/$defs/realtime" },
    "destinations": {
      "type": "object",
      "maxProperties": 1000,
      "propertyNames": { "$ref": "#/$defs/storage_key" },
      "additionalProperties": { "$ref": "#/$defs/destination" }
    },
    "jobs": {
      "type": "object",
      "maxProperties": 1000,
      "propertyNames": { "$ref": "#/$defs/job_key" },
      "additionalProperties": { "$ref": "#/$defs/job" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "metadata": { "required": ["generation"] } },
        "required": ["metadata"]
      },
      "then": {
        "required": ["host"],
        "properties": {
          "host": { "required": ["id"] },
          "destinations": { "propertyNames": { "$ref": "#/$defs/storage_id" } },
          "jobs": { "propertyNames": { "$ref": "#/$defs/job_id" } }
        }
      },
      "else": {
        "allOf": [
          {
            "not": {
              "properties": { "host": { "required": ["id"] } },
              "required": ["host"]
            }
          },
          { "not": { "required": ["realtime"] } }
        ]
      }
    }
  ],
  "$defs": {
    "ulid": { "type": "string", "pattern": "^[0-9a-hjkmnp-tv-z]{26}$" },
    "server_id": { "type": "string", "pattern": "^server_[0-9a-hjkmnp-tv-z]{26}$" },
    "run_id": { "type": "string", "pattern": "^run_[0-9a-hjkmnp-tv-z]{26}$" },
    "job_id": { "type": "string", "pattern": "^job_[0-9a-hjkmnp-tv-z]{26}$" },
    "storage_id": { "type": "string", "pattern": "^storage_[0-9a-hjkmnp-tv-z]{26}$" },
    "job_key": { "type": "string", "pattern": "^job_[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "storage_key": { "type": "string", "pattern": "^storage_[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "cron": { "type": "string", "minLength": 9, "maxLength": 100 },
    "metadata": {
      "oneOf": [
        { "$ref": "#/$defs/standalone_metadata" },
        { "$ref": "#/$defs/managed_metadata" }
      ]
    },
    "standalone_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version"],
      "properties": {
        "schema_version": { "const": 1 }
      }
    },
    "managed_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_revision", "generation", "revision", "schema_version", "issued_at"],
      "properties": {
        "protocol_revision": { "const": "1.15.0" },
        "generation": { "type": "integer", "minimum": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "schema_version": { "const": 1 },
        "issued_at": { "type": "string", "format": "date-time" },
        "digest": {
          "description": "Digest of the managed transport document, recorded only in the installed cache.",
          "$ref": "#/$defs/digest"
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "id": { "$ref": "#/$defs/server_id" }
      }
    },
    "realtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "host", "port", "channel", "auth_url", "encrypted"],
      "properties": {
        "key": { "type": "string", "minLength": 1, "maxLength": 255 },
		"host": { "type": "string", "minLength": 1, "maxLength": 253 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "channel": { "type": "string", "pattern": "^private-agent\\.server_[0-9a-hjkmnp-tv-z]{26}\\.generation_[1-9][0-9]*$" },
		"auth_url": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048 },
        "encrypted": { "const": true }
      }
    },
    "destination": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["driver", "path"],
          "properties": {
            "driver": { "const": "local" },
            "path": { "type": "string", "pattern": "^/", "maxLength": 4096 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["driver", "endpoint", "region", "bucket", "access_key", "secret_key"],
          "properties": {
            "driver": { "const": "s3" },
            "endpoint": { "type": "string", "format": "uri", "maxLength": 2048 },
            "region": { "type": "string", "minLength": 1, "maxLength": 255 },
            "bucket": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$" },
            "prefix": { "type": "string", "minLength": 1, "maxLength": 1024 },
            "access_key": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "secret_key": { "type": "string", "minLength": 1, "maxLength": 1000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["driver", "host", "port", "username", "root_path", "host_keys", "auth"],
          "properties": {
            "driver": { "const": "sftp" },
            "host": { "type": "string", "pattern": "^[A-Za-z0-9.:-]+$", "maxLength": 253 },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "username": { "type": "string", "minLength": 1, "maxLength": 255 },
            "root_path": { "type": "string", "minLength": 1, "maxLength": 1024 },
            "host_keys": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[^ ]+ [A-Za-z0-9+/]+=*$", "maxLength": 4096 }
            },
            "auth": { "$ref": "#/$defs/sftp_auth" }
          }
        }
      ]
    },
    "sftp_auth": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "password"],
          "properties": {
            "method": { "const": "password" },
            "password": { "type": "string", "minLength": 1, "maxLength": 1000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "private_key"],
          "properties": {
            "method": { "const": "ed25519" },
            "private_key": { "type": "string", "minLength": 1, "maxLength": 16384 }
          }
        }
      ]
    },
    "job": {
      "oneOf": [
		{ "$ref": "#/$defs/file_job" },
		{ "$ref": "#/$defs/mysql_job" },
		{ "$ref": "#/$defs/mysql_filtered_job" },
		{ "$ref": "#/$defs/postgresql_job" },
		{ "$ref": "#/$defs/postgresql_filtered_job" }
      ]
    },
    "file_job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "source", "repository", "schedule"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "type": { "const": "file" },
        "enabled": { "type": "boolean", "default": true },
        "source": { "$ref": "#/$defs/file_source" },
        "repository": { "$ref": "#/$defs/repository" },
        "schedule": { "$ref": "#/$defs/cron" },
        "maintenance": { "$ref": "#/$defs/maintenance" },
        "retention": { "$ref": "#/$defs/retention" },
        "integrity": { "$ref": "#/$defs/integrity" },
        "safety": { "$ref": "#/$defs/safety" },
        "replicas": { "$ref": "#/$defs/replicas" },
        "replica_setups": { "$ref": "#/$defs/replicas" },
        "replication": { "$ref": "#/$defs/replication" }
      }
    },
    "file_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root"],
      "properties": {
        "root": { "type": "string", "pattern": "^/", "maxLength": 4096 },
        "paths": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "pattern": "^/", "maxLength": 4096 } },
        "one_file_system": { "const": true, "default": true },
        "excludes": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } }
      }
    },
	"mysql_job": {
	  "type": "object", "additionalProperties": false,
	  "required": ["type", "source", "repository", "schedule"],
	  "properties": {
		"name": { "type": "string", "minLength": 1, "maxLength": 255 }, "type": { "const": "mysql" },
		"enabled": { "type": "boolean", "default": true }, "source": { "allOf": [{ "$ref": "#/$defs/mysql_source" }, { "not": { "required": ["table_selection"] } }, { "properties": { "selection": { "properties": { "mode": { "enum": ["selected", "all_accessible", "all_persistent"] } } } } }] },
		"repository": { "$ref": "#/$defs/repository" }, "schedule": { "$ref": "#/$defs/cron" },
		"maintenance": { "$ref": "#/$defs/maintenance" },
		"retention": { "$ref": "#/$defs/retention" }, "integrity": { "$ref": "#/$defs/integrity" }, "safety": { "$ref": "#/$defs/safety" }, "replicas": { "$ref": "#/$defs/replicas" }, "replica_setups": { "$ref": "#/$defs/replicas" }, "replication": { "$ref": "#/$defs/replication" }
	  }
	},
	"mysql_filtered_job": {
	  "type": "object", "additionalProperties": false,
	  "required": ["type", "source", "repository", "schedule"],
	  "properties": {
		"name": { "type": "string", "minLength": 1, "maxLength": 255 }, "type": { "const": "mysql_filtered" },
		"enabled": { "type": "boolean", "default": true }, "source": { "allOf": [{ "$ref": "#/$defs/mysql_source" }, { "anyOf": [{ "properties": { "selection": { "properties": { "mode": { "const": "exclude" } } } } }, { "required": ["table_selection"] }] }, { "if": { "properties": { "table_selection": { "properties": { "mode": { "const": "include" } }, "required": ["mode"] } }, "required": ["table_selection"] }, "then": { "properties": { "selection": { "properties": { "mode": { "const": "selected" } }, "required": ["mode"] } } } }] },
		"repository": { "$ref": "#/$defs/repository" }, "schedule": { "$ref": "#/$defs/cron" },
		"maintenance": { "$ref": "#/$defs/maintenance" },
		"retention": { "$ref": "#/$defs/retention" }, "integrity": { "$ref": "#/$defs/integrity" }, "safety": { "$ref": "#/$defs/safety" }, "replicas": { "$ref": "#/$defs/replicas" }, "replica_setups": { "$ref": "#/$defs/replicas" }, "replication": { "$ref": "#/$defs/replication" }
	  }
	},
	"mysql_source": {
	  "type": "object", "additionalProperties": false,
	  "required": ["host", "port", "username", "selection", "dump"],
	  "properties": {
		"host": { "type": "string", "minLength": 1, "maxLength": 255 }, "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
		"username": { "type": "string", "minLength": 1, "maxLength": 255 }, "password": { "type": "string", "maxLength": 4096 },
		"password_file": { "type": "string", "pattern": "^/", "maxLength": 4096 },
		"selection": { "type": "object", "additionalProperties": false, "required": ["mode"], "properties": { "mode": { "enum": ["selected", "all_accessible", "all_persistent", "exclude"] }, "databases": { "type": "array", "maxItems": 1000, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } } }, "allOf": [{ "if": { "properties": { "mode": { "enum": ["selected", "exclude"] } } }, "then": { "required": ["databases"], "properties": { "databases": { "minItems": 1 } } } }, { "if": { "properties": { "mode": { "enum": ["all_accessible", "all_persistent"] } } }, "then": { "properties": { "databases": { "maxItems": 0 } } } }] },
		"dump": { "type": "object", "additionalProperties": false, "properties": { "include_routines": { "type": "boolean" }, "include_events": { "type": "boolean" }, "custom_flags": { "type": "array", "maxItems": 50, "uniqueItems": true, "items": { "type": "string", "pattern": "^--[a-z0-9][a-z0-9-]*(=.*)?$", "maxLength": 512 } } } },
		"table_selection": { "$ref": "#/$defs/mysql_table_selection" }
	  },
	  "not": { "required": ["password", "password_file"] }
	},
	"mysql_table_selection": {
	  "type": "object", "additionalProperties": false, "required": ["mode", "tables"],
	  "properties": {
		"mode": { "enum": ["include", "exclude"] },
		"tables": { "type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": { "type": "object", "additionalProperties": false, "required": ["database", "table"], "properties": { "database": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[^-]" }, "table": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[^-]" } } } }
	  }
	},
	"postgresql_job": {
	  "type": "object", "additionalProperties": false,
	  "required": ["type", "source", "repository", "schedule"],
	  "properties": {
		"name": { "type": "string", "minLength": 1, "maxLength": 255 }, "type": { "const": "postgresql" },
		"enabled": { "type": "boolean", "default": true }, "source": { "allOf": [{ "$ref": "#/$defs/postgresql_source" }, { "not": { "required": ["table_selection"] } }, { "properties": { "selection": { "properties": { "mode": { "enum": ["selected", "all_accessible"] } } } } }] },
		"repository": { "$ref": "#/$defs/repository" }, "schedule": { "$ref": "#/$defs/cron" },
		"maintenance": { "$ref": "#/$defs/maintenance" },
		"retention": { "$ref": "#/$defs/retention" }, "integrity": { "$ref": "#/$defs/integrity" }, "safety": { "$ref": "#/$defs/safety" }, "replicas": { "$ref": "#/$defs/replicas" }, "replica_setups": { "$ref": "#/$defs/replicas" }, "replication": { "$ref": "#/$defs/replication" }
	  }
	},
	"postgresql_filtered_job": {
	  "type": "object", "additionalProperties": false,
	  "required": ["type", "source", "repository", "schedule"],
	  "properties": {
		"name": { "type": "string", "minLength": 1, "maxLength": 255 }, "type": { "const": "postgresql_filtered" },
		"enabled": { "type": "boolean", "default": true }, "source": { "allOf": [{ "$ref": "#/$defs/postgresql_source" }, { "anyOf": [{ "properties": { "selection": { "properties": { "mode": { "const": "exclude" } } } } }, { "required": ["table_selection"] }] }, { "if": { "properties": { "table_selection": { "properties": { "mode": { "const": "include" } }, "required": ["mode"] } }, "required": ["table_selection"] }, "then": { "properties": { "selection": { "properties": { "mode": { "const": "selected" } }, "required": ["mode"] } } } }] },
		"repository": { "$ref": "#/$defs/repository" }, "schedule": { "$ref": "#/$defs/cron" },
		"maintenance": { "$ref": "#/$defs/maintenance" },
		"retention": { "$ref": "#/$defs/retention" }, "integrity": { "$ref": "#/$defs/integrity" }, "safety": { "$ref": "#/$defs/safety" }, "replicas": { "$ref": "#/$defs/replicas" }, "replica_setups": { "$ref": "#/$defs/replicas" }, "replication": { "$ref": "#/$defs/replication" }
	  }
	},
	"postgresql_source": {
	  "type": "object", "additionalProperties": false,
	  "required": ["host", "port", "username", "connection_database", "selection"],
	  "properties": {
		"host": { "type": "string", "minLength": 1, "maxLength": 255 }, "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
		"username": { "type": "string", "minLength": 1, "maxLength": 255 }, "password": { "type": "string", "maxLength": 4096 },
		"password_file": { "type": "string", "pattern": "^/", "maxLength": 4096 },
		"connection_database": { "type": "string", "minLength": 1, "maxLength": 63 },
		"selection": { "type": "object", "additionalProperties": false, "required": ["mode"], "properties": { "mode": { "enum": ["selected", "all_accessible", "exclude"] }, "databases": { "type": "array", "maxItems": 1000, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 63, "not": { "enum": ["template0", "template1"] } } } }, "allOf": [{ "if": { "properties": { "mode": { "enum": ["selected", "exclude"] } } }, "then": { "required": ["databases"], "properties": { "databases": { "minItems": 1 } } } }, { "if": { "properties": { "mode": { "const": "all_accessible" } } }, "then": { "properties": { "databases": { "maxItems": 0 } } } }] },
		"table_selection": { "$ref": "#/$defs/postgresql_table_selection" }
	  },
	  "not": { "required": ["password", "password_file"] }
	},
	"postgresql_table_selection": {
	  "type": "object", "additionalProperties": false, "required": ["mode", "tables"],
	  "properties": {
		"mode": { "enum": ["include", "exclude"] },
		"tables": { "type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": { "type": "object", "additionalProperties": false, "required": ["database", "schema", "table"], "properties": { "database": { "type": "string", "minLength": 1, "maxLength": 63 }, "schema": { "type": "string", "minLength": 1, "maxLength": 63 }, "table": { "type": "string", "minLength": 1, "maxLength": 63 } } } }
	  }
	},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["destination", "path", "password"],
      "properties": {
        "repository_key": { "type": "string", "pattern": "^repository_[0-9a-hjkmnp-tv-z]{26}$" },
        "id": {
          "description": "Restic repository identity, not a Backup Chief resource ID.",
          "$ref": "#/$defs/digest"
        },
        "destination": { "$ref": "#/$defs/storage_key" },
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "password": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "replicas": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/replica_repository" }
    },
    "replica_repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_key", "destination", "path", "password", "status", "source"],
      "properties": {
        "repository_key": { "type": "string", "pattern": "^repository_[0-9a-hjkmnp-tv-z]{26}$" },
        "id": { "$ref": "#/$defs/digest" },
        "destination": { "$ref": "#/$defs/storage_key" },
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "password": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "status": { "enum": ["provisioning", "active", "failed"] },
        "source": { "type": "string", "pattern": "^repository_[0-9a-hjkmnp-tv-z]{26}$" }
      }
    },
    "replication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "coalesce", "safety_hold_seconds"],
      "properties": {
        "mode": { "const": "attached" },
        "coalesce": { "const": true },
        "safety_hold_seconds": { "type": "integer", "minimum": 0, "maximum": 2592000 }
      }
    },
    "maintenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "max_deferral_seconds", "prune_interval_seconds"],
      "properties": {
        "strategy": { "const": "after_scheduled_backup" },
        "max_deferral_seconds": { "type": "integer", "minimum": 3600, "maximum": 604800 },
        "prune_interval_seconds": { "type": "integer", "minimum": 86400, "maximum": 2678400 }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "last": { "type": "integer", "minimum": 0, "maximum": 8760, "default": 12 },
        "hourly": { "type": "integer", "minimum": 0, "maximum": 8760, "default": 24 },
        "daily": { "type": "integer", "minimum": 0, "maximum": 3660, "default": 7 },
        "weekly": { "type": "integer", "minimum": 0, "maximum": 520, "default": 4 },
        "monthly": { "type": "integer", "minimum": 0, "maximum": 120, "default": 3 },
        "yearly": { "type": "integer", "minimum": 0, "maximum": 100, "default": 0 },
        "forget_schedule": { "$ref": "#/$defs/cron" },
        "prune_schedule": { "$ref": "#/$defs/cron" }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metadata_schedule": { "$ref": "#/$defs/cron" },
        "data_schedule": { "$ref": "#/$defs/cron" },
        "data_parts": { "type": "integer", "minimum": 2, "maximum": 12 }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "latest_complete": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["run_id", "finished_at", "snapshot_ids"],
          "properties": {
            "run_id": { "$ref": "#/$defs/run_id" },
            "finished_at": { "type": "string", "format": "date-time" },
            "snapshot_ids": {
              "description": "Restic snapshot identities, not Backup Chief resource IDs.",
              "type": "array",
              "minItems": 1,
              "maxItems": 1000,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/digest" }
            }
          }
        },
        "has_unresolved_runs": { "type": "boolean", "default": false },
        "protected_snapshot_ids": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/digest" }
        },
        "protected_run_ids": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/run_id" }
        }
      }
    }
  }
}
